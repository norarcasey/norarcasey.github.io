# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
/test-results
/playwright-report
/blob-report
/.playwright

# production (built by CI and published to GitHub Pages via Actions)
/build
/dist

# blog JSON, fetched from Supabase at build time (scripts/blogContent.ts)
/public/blog

# local Supabase credentials for the build-time blog fetch
.env

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Written by `vercel link`. Holds the project and org ids, and a short-lived
# OIDC token.
.vercel

# `.env*` is what the Vercel CLI adds, which would also swallow .env.example.
# That file is tracked on purpose: it is how somebody knows what to put in .env.
.env
.env.local
